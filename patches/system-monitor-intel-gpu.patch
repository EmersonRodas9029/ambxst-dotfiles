+    def _intel_busy(self, gpu):
+        """% de uso de una iGPU Intel leyendo /proc/*/fdinfo (igual que nvtop).
+
+        ponytail: recorre /proc en cada muestra. Barato porque el monitor solo corre
+        con el dashboard abierto en la pestaña de recursos; si molestara, el salto es
+        a intel_gpu_top, que necesita permisos de perf.
+        """
+        pdev = gpu.get("pdev")
+        total = 0
+        seen = set()
+        for pid in os.listdir("/proc"):
+            if not pid.isdigit():
+                continue
+            fddir = f"/proc/{pid}/fdinfo"
+            try:
+                fds = os.listdir(fddir)
+            except OSError:
+                continue
+            for fd in fds:
+                try:
+                    with open(os.path.join(fddir, fd), "r") as f:
+                        data = f.read()
+                except OSError:
+                    continue
+                if "drm-client-id" not in data:
+                    continue
+                cid = None
+                same_card = pdev is None
+                busy = 0
+                for line in data.splitlines():
+                    if line.startswith("drm-client-id:"):
+                        cid = line.split(":", 1)[1].strip()
+                    elif line.startswith("drm-pdev:"):
+                        same_card = line.split(":", 1)[1].strip() == pdev
+                    elif line.startswith("drm-engine-"):
+                        # render, copy, video y video-enhance van al mismo total
+                        try:
+                            busy += int(line.split(":", 1)[1].strip().split()[0])
+                        except ValueError:
+                            pass
+                if cid is not None and same_card and cid not in seen:
+                    seen.add(cid)
+                    total += busy
+
+        now = time.monotonic()
+        prev_ns, prev_t = gpu.get("prev_ns"), gpu.get("prev_t")
+        gpu["prev_ns"], gpu["prev_t"] = total, now
+        if prev_ns is None or now <= prev_t:
+            return 0.0
+        pct = (total - prev_ns) / ((now - prev_t) * 1e9) * 100.0
+        return max(0.0, min(100.0, pct))
+
